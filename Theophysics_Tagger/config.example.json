{
  "registry": "01_REGISTRY/tag_registry.csv",
  "default_sources": [
    "sources"
  ],
  "output_dir": "02_INDEX",
  "tagged_dir": "03_TAGGED",
  "extensions": [
    ".md",
    ".txt"
  ],
  "granularity": [
    "document",
    "paragraph",
    "sentence"
  ],
  "read_only_default": true,
  "copy_requires_flag": "--copy-by-primary-tag",
  "minimum_hits_for_document_tag": 1,
  "sentence_split_regex": "(?<=[.!?])\\s+"
}
