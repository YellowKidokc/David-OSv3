@echo off
setlocal
REM FIS - index the folder passed by Send To and open its FIS.html.
REM Generated by INSTALL_SENDTO.bat - edit the installer, not this file.

set "TARGET=%~1"
if "%TARGET%"=="" (
  echo Usage: right-click a folder, then Send To ^> FIS Index This Folder
  pause
  exit /b 1
)
if not exist "%TARGET%\" (
  echo Not a folder: %TARGET%
  pause
  exit /b 1
)

echo FIS indexing: %TARGET%
echo This can take a while on network folders. Leave this window open.
echo.
python "D:\GitHub\David-OS\file-intelligence-system\fis_folder_memory.py" "%TARGET%" --tree --write --html --doc-types --no-local-ai
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
  echo FIS scan exited with code %RC%.
  pause
  exit /b %RC%
)

if exist "%TARGET%\FIS.html" (
  start "" "%TARGET%\FIS.html"
) else (
  echo Scan finished but no FIS.html was written in %TARGET%
  pause
)
endlocal
