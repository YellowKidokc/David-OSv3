@echo off
setlocal enabledelayedexpansion

REM ---------------------------------------------------------------------------
REM  FIS - install the "Send To" folder indexer.
REM
REM  Writes FIS_Index_Folder.bat next to this script, then drops a shortcut to
REM  it in the user's SendTo folder. After this runs:
REM      right-click any folder -> Send To -> FIS Index This Folder
REM
REM  Run once. Re-running is safe; it overwrites both.
REM ---------------------------------------------------------------------------

set "FIS_DIR=%~dp0"
if "%FIS_DIR:~-1%"=="\" set "FIS_DIR=%FIS_DIR:~0,-1%"
set "LAUNCHER=%FIS_DIR%\FIS_Index_Folder.bat"
set "SENDTO=%APPDATA%\Microsoft\Windows\SendTo"
set "SHORTCUT=%SENDTO%\FIS Index This Folder.lnk"

echo.
echo FIS Send To installer
echo   scripts : %FIS_DIR%
echo   sendto  : %SENDTO%
echo.

if not exist "%FIS_DIR%\fis_folder_memory.py" (
  echo ERROR: fis_folder_memory.py not found in %FIS_DIR%
  echo        Run this installer from the file-intelligence-system folder.
  goto :fail
)

REM --- write the launcher ----------------------------------------------------
REM  Send To passes the selected folder as %1. Inside this installer that must
REM  be written as %%1 so it survives into the generated file.
> "%LAUNCHER%" echo @echo off
>>"%LAUNCHER%" echo setlocal
>>"%LAUNCHER%" echo REM FIS - index the folder passed by Send To and open its FIS.html.
>>"%LAUNCHER%" echo REM Generated by INSTALL_SENDTO.bat - edit the installer, not this file.
>>"%LAUNCHER%" echo.
>>"%LAUNCHER%" echo set "TARGET=%%~1"
>>"%LAUNCHER%" echo if "%%TARGET%%"=="" (
REM  The redirect character needs escaping twice: once for this installer, once
REM  more so the generated launcher prints it instead of redirecting to a file.
>>"%LAUNCHER%" echo   echo Usage: right-click a folder, then Send To ^^^> FIS Index This Folder
>>"%LAUNCHER%" echo   pause
>>"%LAUNCHER%" echo   exit /b 1
>>"%LAUNCHER%" echo ^)
>>"%LAUNCHER%" echo if not exist "%%TARGET%%\" (
>>"%LAUNCHER%" echo   echo Not a folder: %%TARGET%%
>>"%LAUNCHER%" echo   pause
>>"%LAUNCHER%" echo   exit /b 1
>>"%LAUNCHER%" echo ^)
>>"%LAUNCHER%" echo.
>>"%LAUNCHER%" echo echo FIS indexing: %%TARGET%%
>>"%LAUNCHER%" echo echo This can take a while on network folders. Leave this window open.
>>"%LAUNCHER%" echo echo.
>>"%LAUNCHER%" echo python "%FIS_DIR%\fis_folder_memory.py" "%%TARGET%%" --tree --write --html --doc-types --no-local-ai
>>"%LAUNCHER%" echo set "RC=%%ERRORLEVEL%%"
>>"%LAUNCHER%" echo.
>>"%LAUNCHER%" echo if not "%%RC%%"=="0" (
>>"%LAUNCHER%" echo   echo FIS scan exited with code %%RC%%.
>>"%LAUNCHER%" echo   pause
>>"%LAUNCHER%" echo   exit /b %%RC%%
>>"%LAUNCHER%" echo ^)
>>"%LAUNCHER%" echo.
>>"%LAUNCHER%" echo if exist "%%TARGET%%\FIS.html" (
>>"%LAUNCHER%" echo   start "" "%%TARGET%%\FIS.html"
>>"%LAUNCHER%" echo ^) else (
>>"%LAUNCHER%" echo   echo Scan finished but no FIS.html was written in %%TARGET%%
>>"%LAUNCHER%" echo   pause
>>"%LAUNCHER%" echo ^)
>>"%LAUNCHER%" echo endlocal

if not exist "%LAUNCHER%" (
  echo ERROR: could not write %LAUNCHER%
  goto :fail
)
echo   wrote %LAUNCHER%

REM --- drop the Send To shortcut ---------------------------------------------
if not exist "%SENDTO%" mkdir "%SENDTO%"

powershell -NoProfile -ExecutionPolicy Bypass -Command "$w = New-Object -ComObject WScript.Shell; $s = $w.CreateShortcut($env:SHORTCUT); $s.TargetPath = $env:LAUNCHER; $s.WorkingDirectory = $env:FIS_DIR; $s.Description = 'Index this folder with the FIS folder-memory scanner'; $s.IconLocation = 'shell32.dll,3'; $s.Save()"

if not exist "%SHORTCUT%" (
  echo ERROR: could not create %SHORTCUT%
  goto :fail
)

echo   wrote %SHORTCUT%
echo.
echo Installed. Right-click any folder -^> Send To -^> FIS Index This Folder
echo.
endlocal
exit /b 0

:fail
echo.
echo Install failed. Nothing was registered.
echo.
endlocal
exit /b 1
