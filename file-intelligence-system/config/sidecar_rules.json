{
  "protected_extensions": [".fmeta", ".chi", ".fisnote", ".fistag", ".fisdead", ".canon.sidecar.json"],
  "file_sidecars": {
    "metadata": ".fmeta",
    "classification": ".chi",
    "metadata_classification": ".fmeta.chi",
    "canon_status": ".canon.sidecar.json",
    "research_note": ".fisnote",
    "tag": ".fistag",
    "tombstone": ".fisdead"
  },
  "folder_sidecars": {
    "metadata": ".folder.fmeta"
  },
  "rules": {
    "never_delete_protected_sidecars_without_approval": true,
    "sidecars_are_plain_text": true,
    "do_not_embed_executable_code_in_files": true,
    "index_sidecars_into_sqlite": true,
    "one_canon_sidecar_per_file": true,
    "append_dont_overwrite_human_sidecars": true,
    "no_sidecar_no_canon_opinion": true
  }
}
