  "status_fallback": "AC",
  "archive_after_days": 365,
  "series": [
    {
      "pattern": "^gtq[_ -]*(\\d+)([a-z]?)(?=[ ._-]|$)",
      "as": "gtq_{n}{x}"
    },
    {
      "pattern": "^chapter[_ -]*(\\d+)([a-z]?)(?=[ ._-]|$)",
      "as": "ch{n}{x}"
    },
    {
      "pattern": "^paper[_ -]*(\\d+)([a-z]?)(?=[ ._-]|$)",
      "as": "p{n}{x}"
    },
    {
      "pattern": "^p(\\d+)([a-z]?)_",
      "as": "p{n}{x}"
    },
    {
      "pattern": "^(\\d+)\\.(\\d+)(?=[ ._-])",
      "as": "{n}_{x}"
    },
    {
      "pattern": "^(\\d+)[ ._-]*([a-z]?)(?=[ ._-])",
      "as": "{n}{x}"
    }
  ],
  "drop_words": [
