{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "david-os/classification.v1",
  "title": "classification v1",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "created_at",
    "source_path",
    "sha256",
    "status",
    "labels"
  ],
  "properties": {
    "schema_version": {
      "const": "classification.v1"
    },
    "producer": {
      "type": "string",
      "description": "app name + version"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "skipped",
        "needs_review"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "confidence"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "classifier": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
