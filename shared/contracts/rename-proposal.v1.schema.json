{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "david-os/rename-proposal.v1",
  "title": "rename-proposal v1",
  "type": "object",
  "required": [
    "schema_version",
    "producer",
    "created_at",
    "source_path",
    "sha256",
    "status",
    "proposed_name",
    "review_state"
  ],
  "properties": {
    "schema_version": {
      "const": "rename-proposal.v1"
    },
    "producer": {
      "type": "string",
      "description": "app name + version"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "skipped",
        "needs_review"
      ]
    },
    "proposed_name": {
      "type": "string"
    },
    "proposed_dir": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "applied"
      ]
    },
    "recovery": {
      "type": "object",
      "description": "original path + hash needed to undo"
    }
  }
}
